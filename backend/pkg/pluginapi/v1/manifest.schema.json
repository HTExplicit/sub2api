{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sub2api.local/schemas/plugin-manifest-v1.json",
  "title": "Sub2API Plugin Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "version", "requires", "capabilities", "runtimes", "ui", "files"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "maxLength": 160, "pattern": "^[a-z0-9]+([._-][a-z0-9]+)+$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 160 },
    "version": { "type": "string", "pattern": "^v?(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$" },
    "description": { "type": "string" },
    "author": { "type": "string", "maxLength": 160 },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sub2api", "plugin_protocol", "transport_api", "ui_bridge"],
      "properties": {
        "sub2api": { "type": "string", "minLength": 1 },
        "recommended_sub2api_version": { "type": "string" },
        "tested_sub2api_versions": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "plugin_protocol": { "const": 1 },
        "transport_api": { "const": 1 },
        "ui_bridge": { "const": 1 },
        "extension_api": { "const": 1 }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "platform", "account_type"],
        "properties": {
          "id": { "enum": ["openai.oauth.outbound_transport.v1", "extensions.provider.v1", "extensions.catalog.v1", "extensions.request.v1", "extensions.scheduling.v1", "extensions.jobs.v1", "extensions.admin.v1", "extensions.ui.v1", "extensions.credentials.v1"] },
          "platform": { "type": "string", "minLength": 1 },
          "account_type": { "type": "string", "minLength": 1 }
        }
      }
    },
    "operations": {
      "type": "object",
      "additionalProperties": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*$" } }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["capability"],
        "properties": { "capability": { "type": "string" }, "platform": { "type": "string" }, "account_type": { "type": "string" } }
      }
    },
    "contributions": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "slot", "label", "permission"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "config_flag": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
          "slot": { "enum": ["admin.page", "admin.settings", "account.actions", "account.details", "account.columns", "account.test", "group.actions", "group.details", "navigation", "theme", "usage.details", "surface"] },
          "label": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string" } },
          "permission": { "type": "string", "minLength": 1 },
          "action": { "type": "string" }, "entrypoint": { "type": "string", "pattern": "^ui/.+" },
          "order": { "type": "integer" },
          "fields": {
            "type": "array", "items": {
              "type": "object", "additionalProperties": false,
              "required": ["key", "kind", "label", "options_source", "default_label"],
              "properties": {
                "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
                "kind": { "const": "select" },
                "label": { "type": "object", "additionalProperties": { "type": "string" } },
                "options_source": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
                "default_label": { "type": "object", "additionalProperties": { "type": "string" } },
                "default_source": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" }
              }
            }
          },
          "account_filter": {
            "type": "object", "additionalProperties": false,
            "properties": {
              "platforms": { "type": "array", "items": { "type": "string" } },
              "types": { "type": "array", "items": { "type": "string" } },
              "statuses": { "type": "array", "items": { "type": "string" } },
              "exclude_shadows": { "type": "boolean" }
            }
          }
        }
      }
    },
    "runtimes": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^[a-z0-9]+-[a-z0-9]+$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path"],
          "properties": { "path": { "$ref": "#/$defs/safePath" } }
        }
      },
      "additionalProperties": false
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entrypoint"],
      "properties": { "entrypoint": { "type": "string", "pattern": "^ui/.+" } }
    },
    "files": {
      "type": "object",
      "minProperties": 2,
      "propertyNames": { "$ref": "#/$defs/safePath" },
      "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
    }
  },
  "$defs": {
    "safePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sub2api.local/schemas/plugin-manifest-v1.json",
  "title": "Sub2API Plugin Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "version",
    "requires",
    "capabilities",
    "runtimes",
    "ui",
    "files"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "source_revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "id": {
      "type": "string",
      "maxLength": 160,
      "pattern": "^[a-z0-9]+([._-][a-z0-9]+)+$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "version": {
      "type": "string",
      "pattern": "^v?(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
    },
    "description": {
      "type": "string"
    },
    "author": {
      "type": "string",
      "maxLength": 160
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sub2api",
        "plugin_protocol",
        "transport_api",
        "ui_bridge"
      ],
      "properties": {
        "sub2api": {
          "type": "string",
          "minLength": 1
        },
        "recommended_sub2api_version": {
          "type": "string"
        },
        "tested_sub2api_versions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "plugin_protocol": {
          "const": 1
        },
        "transport_api": {
          "const": 1
        },
        "ui_bridge": {
          "const": 1
        },
        "extension_api": {
          "const": 1
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "platform",
          "account_type"
        ],
        "properties": {
          "id": {
            "enum": [
              "openai.oauth.outbound_transport.v1",
              "extensions.provider.v1",
              "extensions.catalog.v1",
              "extensions.request.v1",
              "extensions.scheduling.v1",
              "extensions.jobs.v1",
              "extensions.admin.v1",
              "extensions.ui.v1",
              "extensions.credentials.v1",
              "extensions.observability.v1",
              "extensions.recovery.v1"
            ]
          },
          "platform": {
            "type": "string",
            "minLength": 1
          },
          "account_type": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "operations": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "maxItems": 64,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*$"
        }
      }
    },
    "resources": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "capability",
          "permission"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*(\\.[a-z][a-z0-9]*(-[a-z0-9]+)*)+$"
          },
          "capability": {
            "type": "string",
            "minLength": 1
          },
          "permission": {
            "enum": [
              "admin",
              "user"
            ]
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capability"
        ],
        "properties": {
          "capability": {
            "type": "string"
          },
          "platform": {
            "type": "string"
          },
          "account_type": {
            "type": "string"
          }
        }
      }
    },
    "contributions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "slot",
          "label",
          "permission"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "capability": {
            "type": "string",
            "minLength": 1
          },
          "config_flag": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "retained_controls": {
            "type": "boolean"
          },
          "all_accounts": {
            "type": "boolean"
          },
          "display_fields": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "key",
                "kind"
              ],
              "properties": {
                "key": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,63}$"
                },
                "kind": {
                  "enum": [
                    "text",
                    "badge",
                    "datetime"
                  ]
                },
                "prefix": {
                  "type": "string",
                  "maxLength": 32
                },
                "new_line": {
                  "type": "boolean"
                },
                "values": {
                  "type": "object",
                  "maxProperties": 64,
                  "additionalProperties": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "label"
                    ],
                    "properties": {
                      "label": {
                        "type": "object",
                        "minProperties": 1,
                        "additionalProperties": {
                          "type": "string"
                        }
                      },
                      "tone": {
                        "enum": [
                          "neutral",
                          "success",
                          "warning",
                          "danger",
                          "info",
                          ""
                        ]
                      }
                    }
                  }
                }
              }
            }
          },
          "events": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
            }
          },
          "assets": {
            "type": "array",
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^ui/.+\\.woff2$"
            }
          },
          "slot": {
            "enum": [
              "admin.page",
              "admin.settings",
              "account.actions",
              "account.details",
              "account.columns",
              "account.test",
              "account.test.prompt",
              "group.actions",
              "group.details",
              "navigation",
              "theme",
              "usage.details",
              "surface",
              "account.view.v1",
              "account.create.v1",
              "account.edit.v1"
            ]
          },
          "label": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string"
            }
          },
          "permission": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string"
          },
          "entrypoint": {
            "type": "string",
            "pattern": "^ui/.+"
          },
          "order": {
            "type": "integer"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "key",
                "kind",
                "label"
              ],
              "properties": {
                "key": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,63}$"
                },
                "kind": {
                  "enum": [
                    "select",
                    "textarea",
                    "text"
                  ]
                },
                "rows": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 12
                },
                "max_length": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65536
                },
                "placeholder": {
                  "type": "string"
                },
                "hint": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "reset_label": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "limit_message": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "label": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "options_source": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,63}$"
                },
                "default_label": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "default_source": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,63}$"
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "select"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "options_source",
                      "default_label"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "textarea"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "rows",
                      "max_length"
                    ]
                  }
                }
              ]
            }
          },
          "account_filter": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "platforms": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "types": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "statuses": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "exclude_shadows": {
                "type": "boolean"
              }
            }
          },
          "account_view": {
            "$ref": "#/$defs/accountView"
          },
          "value_bindings": {
            "type": "object",
            "maxProperties": 16,
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            },
            "additionalProperties": {
              "enum": [
                "cindy_balance_probe_job_id",
                "cindy_balance_probe_outcome",
                "cindy_balance_probe_checked_at"
              ]
            }
          },
          "resource_action": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "version",
              "resource",
              "account_parameter",
              "account_source",
              "effect"
            ],
            "properties": {
              "version": {
                "const": 1
              },
              "resource": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*(\\.[a-z][a-z0-9]*(-[a-z0-9]+)*)+$"
              },
              "account_parameter": {
                "const": "id"
              },
              "account_source": {
                "const": "row.id"
              },
              "row_predicate": {
                "$ref": "#/$defs/accountViewPredicate"
              },
              "effect": {
                "const": "refresh_current_account_view"
              }
            }
          },
          "account_create": {
            "$ref": "#/$defs/accountCreate"
          },
          "account_edit": {
            "$ref": "#/$defs/accountEdit"
          }
        },
        "allOf": [
          {
            "if": {"properties": {"slot": {"const": "account.edit.v1"}}},
            "then": {
              "required": ["account_edit", "capability"],
              "properties": {
                "permission": {"const": "admin"},
                "capability": {"const": "extensions.provider.v1"},
                "entrypoint": {"maxLength": 0}, "action": {"maxLength": 0},
                "all_accounts": {"const": false}, "retained_controls": {"const": false},
                "fields": {"maxItems": 0}, "display_fields": {"maxItems": 0},
                "assets": {"maxItems": 0}, "events": {"maxItems": 0},
                "value_bindings": {"maxProperties": 0}
              },
              "not": {"anyOf": [{"required": ["account_filter"]}, {"required": ["resource_action"]}]}
            },
            "else": {"not": {"required": ["account_edit"]}}
          },
          {
            "if": {
              "properties": {
                "slot": {
                  "const": "account.view.v1"
                }
              }
            },
            "then": {
              "required": [
                "account_view",
                "capability"
              ],
              "properties": {
                "permission": {
                  "const": "admin"
                },
                "entrypoint": {
                  "maxLength": 0
                },
                "action": {
                  "maxLength": 0
                },
                "retained_controls": {
                  "const": false
                }
              }
            },
            "else": {
              "not": {
                "required": [
                  "account_view"
                ]
              }
            }
          },
          {
            "if": {
              "required": [
                "resource_action"
              ]
            },
            "then": {
              "required": [
                "capability"
              ],
              "properties": {
                "slot": {
                  "const": "account.actions"
                },
                "permission": {
                  "const": "admin"
                },
                "entrypoint": {
                  "maxLength": 0
                },
                "action": {
                  "maxLength": 0
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "value_bindings"
              ]
            },
            "then": {
              "properties": {
                "slot": {
                  "const": "account.columns"
                },
                "permission": {
                  "const": "admin"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "slot": {
                  "const": "account.create.v1"
                }
              }
            },
            "then": {
              "required": [
                "account_create",
                "capability"
              ],
              "properties": {
                "permission": {
                  "const": "admin"
                },
                "capability": {
                  "const": "extensions.provider.v1"
                },
                "entrypoint": {
                  "maxLength": 0
                },
                "action": {
                  "maxLength": 0
                },
                "all_accounts": {
                  "const": false
                },
                "retained_controls": {
                  "const": false
                },
                "fields": {
                  "maxItems": 8
                }
              },
              "not": {
                "required": [
                  "account_filter"
                ]
              }
            },
            "else": {
              "not": {
                "required": [
                  "account_create"
                ]
              }
            }
          }
        ]
      }
    },
    "runtimes": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^[a-z0-9]+-[a-z0-9]+$": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "$ref": "#/$defs/safePath"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entrypoint"
      ],
      "properties": {
        "entrypoint": {
          "type": "string",
          "pattern": "^ui/.+"
        }
      }
    },
    "files": {
      "type": "object",
      "minProperties": 2,
      "propertyNames": {
        "$ref": "#/$defs/safePath"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    }
  },
  "$defs": {
    "safePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "accountView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "source",
        "base_query",
        "default_preset",
        "presets",
        "layout",
        "table"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "source": {
          "const": "accounts.console.v1"
        },
        "base_query": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "platforms": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              }
            },
            "types": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              }
            },
            "statuses": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              }
            },
            "plans": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              }
            },
            "privacy_mode": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "cindy_only": {
              "type": "boolean"
            },
            "cindy_balance_status": {
              "enum": [
                "insufficient"
              ]
            },
            "cindy_health_status": {
              "enum": [
                "banned"
              ]
            }
          }
        },
        "default_preset": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{0,63}$"
        },
        "extends_core_filters": {
          "type": "boolean"
        },
        "presets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "query",
              "counter"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9._-]{0,63}$"
              },
              "label": {
                "type": "object",
                "minProperties": 1,
                "maxProperties": 16,
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              },
              "query": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "platforms": {
                    "type": "array",
                    "maxItems": 32,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64
                    }
                  },
                  "types": {
                    "type": "array",
                    "maxItems": 32,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64
                    }
                  },
                  "statuses": {
                    "type": "array",
                    "maxItems": 32,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64
                    }
                  },
                  "plans": {
                    "type": "array",
                    "maxItems": 32,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64
                    }
                  },
                  "privacy_mode": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "cindy_only": {
                    "type": "boolean"
                  },
                  "cindy_balance_status": {
                    "enum": [
                      "insufficient"
                    ]
                  },
                  "cindy_health_status": {
                    "enum": [
                      "banned"
                    ]
                  }
                }
              },
              "counter": {
                "enum": [
                  "cindy_total",
                  "cindy_insufficient_count",
                  "cindy_banned_count"
                ]
              }
            }
          }
        },
        "layout": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "const": "account_table"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "surface_ref"
                ],
                "properties": {
                  "kind": {
                    "const": "surface"
                  },
                  "surface_ref": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9._-]{0,63}$"
                  }
                }
              }
            ]
          }
        },
        "table": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "layouts",
            "column_refs",
            "action_refs"
          ],
          "properties": {
            "layouts": {
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "table",
                  "compact",
                  "cards"
                ]
              }
            },
            "column_refs": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9._-]{0,63}$"
              }
            },
            "action_refs": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9._-]{0,63}$"
              }
            }
          }
        },
        "navigation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "section",
            "target_view",
            "icon"
          ],
          "properties": {
            "section": {
              "const": "admin.extensions"
            },
            "target_view": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9._-]{0,63}$"
            },
            "icon": {
              "const": "accounts"
            },
            "order": {
              "type": "integer",
              "minimum": -10000,
              "maximum": 10000
            }
          }
        },
        "legacy_query_aliases": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "match",
              "preset",
              "priority"
            ],
            "properties": {
              "match": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "properties": {
                  "cindy_only": {
                    "const": "true"
                  },
                  "cindy_balance_status": {
                    "const": "insufficient"
                  },
                  "cindy_health_status": {
                    "const": "banned"
                  }
                }
              },
              "preset": {
                "type": "string",

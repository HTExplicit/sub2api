{
  "schema_version": 1,
  "id": "codexrip.admin-observability",
  "name": "界面与观测",
  "version": "0.2.7",
  "description": "账号流量观测规则与指标展示",
  "author": "HTExplicit",
  "requires": { "sub2api": ">=0.2.7-0 <0.2.8", "tested_sub2api_versions": [], "plugin_protocol": 1, "transport_api": 1, "ui_bridge": 1, "extension_api": 1 },
  "capabilities": [
    { "id": "extensions.ui.v1", "platform": "*", "account_type": "*" },
    { "id": "extensions.observability.v1", "platform": "*", "account_type": "*" },
    { "id": "extensions.admin.v1", "platform": "*", "account_type": "*" }
  ],
  "operations": { "extensions.observability.v1": ["observability.policy"] },
  "contributions": [
    { "id": "flat-theme", "slot": "theme", "config_flag": "theme_enabled", "entrypoint": "ui/assets/theme.css", "assets": ["ui/assets/fonts/MiSans-Regular.woff2", "ui/assets/fonts/MiSans-Medium.woff2", "ui/assets/fonts/MiSans-Semibold.woff2", "ui/assets/fonts/MiSans-Bold.woff2"], "permission": "public", "label": { "zh": "平面主题", "en": "Flat theme" } },
    { "id": "account-traffic", "slot": "account.details", "config_flag": "telemetry_enabled", "action": "telemetry.read", "entrypoint": "ui/index.html", "permission": "admin", "label": { "zh": "流量观测", "en": "Traffic observations" } },
    { "id": "observability-settings", "slot": "admin.settings", "action": "observability.describe", "entrypoint": "ui/index.html", "permission": "admin", "label": { "zh": "观测设置", "en": "Observation settings" } }
  ],
  "runtimes": {},
  "ui": { "entrypoint": "ui/index.html" },
  "files": {}
}

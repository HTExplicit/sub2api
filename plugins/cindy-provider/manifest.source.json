{
  "schema_version": 1,
  "id": "codexrip.cindy-provider",
  "name": "Cindy Provider",
  "version": "0.2.7",
  "description": "Cindy 模型目录、协议能力、价格参考及账号健康判定",
  "author": "HTExplicit",
  "requires": {
    "sub2api": ">=0.2.7-0 <0.2.8",
    "tested_sub2api_versions": [],
    "plugin_protocol": 1,
    "transport_api": 1,
    "ui_bridge": 1,
    "extension_api": 1
  },
  "capabilities": [
    {
      "id": "extensions.provider.v1",
      "platform": "cindy",
      "account_type": "apikey"
    },
    {
      "id": "extensions.admin.v1",
      "platform": "*",
      "account_type": "*"
    }
  ],
  "operations": {
    "extensions.provider.v1": [
      "cindy.catalog",
      "cindy.features",
      "cindy.pricing",
      "cindy.health",
      "cindy.probe.plan",
      "cindy.probe.decide",
      "cindy.duplicates.plan",
      "cindy.groups.input",
      "cindy.groups.partition",
      "cindy.search.plan"
    ]
  },
  "resources": [
    {
      "name": "cindy.probe.list",
      "capability": "extensions.provider.v1",
      "permission": "admin"
    },
    {
      "name": "cindy.probe.create",
      "capability": "extensions.provider.v1",
      "permission": "admin"
    },
    {
      "name": "cindy.probe.preview",
      "capability": "extensions.provider.v1",
      "permission": "admin"
    },
    {
      "name": "cindy.probe.get",
      "capability": "extensions.provider.v1",
      "permission": "admin"
    },
    {
      "name": "cindy.probe.items",
      "capability": "extensions.provider.v1",
      "permission": "admin"
    },
    {
      "name": "cindy.probe.rate",
      "capability": "extensions.provider.v1",
      "permission": "admin"
    },
    {
      "name": "cindy.probe.pause",
      "capability": "extensions.provider.v1",
      "permission": "admin"
    },
    {
      "name": "cindy.probe.resume",
      "capability": "extensions.provider.v1",
      "permission": "admin"
    },
    {
      "name": "cindy.probe.cancel",
      "capability": "extensions.provider.v1",
      "permission": "admin"
    },
    {
      "name": "cindy.duplicates",
      "capability": "extensions.provider.v1",
      "permission": "admin"
    },
    {
      "name": "cindy.groups.audit",
      "capability": "extensions.provider.v1",
      "permission": "admin"
    },
    {
      "name": "cindy.groups.keys",
      "capability": "extensions.provider.v1",
      "permission": "admin"
    },
    {
      "name": "cindy.groups.preview",
      "capability": "extensions.provider.v1",
      "permission": "admin"
    },
    {
      "name": "cindy.groups.split",
      "capability": "extensions.provider.v1",
      "permission": "admin"
    },
    {
      "name": "cindy.cleanup.insufficient.preview",
      "capability": "extensions.provider.v1",
      "permission": "admin"
    },
    {
      "name": "cindy.cleanup.insufficient.submit",
      "capability": "extensions.provider.v1",
      "permission": "admin"
    },
    {
      "name": "cindy.cleanup.banned.preview",
      "capability": "extensions.provider.v1",
      "permission": "admin"
    },
    {
      "name": "cindy.cleanup.banned.submit",
      "capability": "extensions.provider.v1",
      "permission": "admin"
    },
    {
      "name": "cindy.balance.recover",
      "capability": "extensions.provider.v1",
      "permission": "admin"
    }
  ],
  "contributions": [
    {
      "id": "cindy-probe-summary",
      "slot": "account.columns",
      "capability": "extensions.provider.v1",
      "permission": "admin",
      "label": {
        "zh": "最近巡检",
        "en": "Recent probe"
      },
      "display_fields": [
        {
          "key": "job",
          "kind": "text",
          "prefix": "#"
        },
        {
          "key": "outcome",
          "kind": "badge",
          "values": {
            "pending": {
              "label": {
                "zh": "待处理",
                "en": "Pending"
              },
              "tone": "neutral"
            },
            "luna_running": {
              "label": {
                "zh": "Luna 检测中",
                "en": "Luna running"
              },
              "tone": "info"
            },
            "luna_exact": {
              "label": {
                "zh": "Luna 确认耗尽",
                "en": "Luna exhausted"
              },
              "tone": "danger"
            },
            "terra_running": {
              "label": {
                "zh": "Terra 检测中",
                "en": "Terra running"
              },
              "tone": "info"
            },
            "healthy": {
              "label": {
                "zh": "本次 Luna 可用",
                "en": "Luna available this run"
              },
              "tone": "success"
            },
            "recovered": {
              "label": {
                "zh": "已恢复",
                "en": "Recovered"
              },
              "tone": "success"
            },
            "still_exhausted": {
              "label": {
                "zh": "仍然耗尽",
                "en": "Still exhausted"
              },
              "tone": "danger"
            },
            "exhausted": {
              "label": {
                "zh": "额度耗尽",
                "en": "Exhausted"
              },
              "tone": "danger"
            },
            "already_marked": {
              "label": {
                "zh": "已标记",
                "en": "Already marked"
              },
              "tone": "neutral"
            },
            "inconclusive": {
              "label": {
                "zh": "无法确认",
                "en": "Inconclusive"
              },
              "tone": "warning"
            },
            "confirmation_expired": {
              "label": {
                "zh": "确认已过期",
                "en": "Confirmation expired"
              },
              "tone": "warning"
            },
            "skipped_stale": {
              "label": {
                "zh": "账号变化后跳过",
                "en": "Skipped after account change"
              },
              "tone": "neutral"
            },
            "unknown_after_crash": {
              "label": {
                "zh": "中断后状态未知",
                "en": "Unknown after interruption"
              },
              "tone": "warning"
            },
            "canceled": {
              "label": {
                "zh": "已取消",
                "en": "Canceled"
              },
              "tone": "neutral"
            }
          }
        },
        {
          "key": "checked_at",
          "kind": "datetime",
          "new_line": true
        }
      ],
      "value_bindings": {
        "job": "cindy_balance_probe_job_id",
        "outcome": "cindy_balance_probe_outcome",
        "checked_at": "cindy_balance_probe_checked_at"
      }
    },
    {
      "id": "cindy-balance-probe",
      "slot": "surface",
      "entrypoint": "ui/compiled/index.html",
      "retained_controls": true,
      "capability": "extensions.provider.v1",
      "permission": "admin",
      "config_flag": "balance_detection",
      "label": {
        "zh": "Cindy 余额复查",
        "en": "Cindy balance probes"
      }
    },
    {
      "id": "cindy-duplicate-inventory",
      "slot": "surface",
      "entrypoint": "ui/compiled/index.html",
      "capability": "extensions.provider.v1",
      "permission": "admin",
      "label": {
        "zh": "重复身份清单",
        "en": "Duplicate identities"
      }
    },
    {
      "id": "cindy-group-audit",
      "slot": "surface",
      "entrypoint": "ui/compiled/index.html",
      "capability": "extensions.provider.v1",
      "permission": "admin",
      "events": [
        "close",
        "split"
      ],
      "label": {
        "zh": "Cindy 分组审查",
        "en": "Cindy group audit"
      }
    },
    {
      "id": "cindy-provider-settings",
      "slot": "admin.settings",
      "capability": "extensions.admin.v1",
      "action": "provider.describe",
      "entrypoint": "ui/index.html",
      "permission": "admin",
      "label": {
        "zh": "Cindy 目录与策略",
        "en": "Cindy catalog and policies"
      }
    },
    {
      "id": "cindy-accounts",
      "slot": "account.view.v1",
      "capability": "extensions.provider.v1",
      "permission": "admin",
      "label": {
        "zh": "Cindy 账号",
        "en": "Cindy accounts"
      },
      "account_view": {
        "version": 1,
        "source": "accounts.console.v1",
        "base_query": {
          "cindy_only": true
        },
        "default_preset": "cindy",
        "extends_core_filters": true,
        "core_filter_surface_refs": ["cindy-account-controls"],
        "presets": [
          {
            "id": "cindy",
            "label": {
              "zh": "Cindy 账号",
              "en": "Cindy accounts"
            },
            "query": {},
            "counter": "cindy_total"
          },
          {
            "id": "insufficient",
            "label": {
              "zh": "额度耗尽",
              "en": "Insufficient balance"
            },
            "query": {
              "cindy_balance_status": "insufficient"
            },
            "counter": "cindy_insufficient_count"
          },
          {
            "id": "banned",
            "label": {
              "zh": "已封禁",
              "en": "Banned"
            },
            "query": {
              "cindy_health_status": "banned"
            },
            "counter": "cindy_banned_count"
          }
        ],
        "layout": [
          {
            "kind": "surface",
            "surface_ref": "cindy-duplicate-inventory"
          },
          {
            "kind": "surface",
            "surface_ref": "cindy-balance-probe"
          },
          {
            "kind": "surface",
            "surface_ref": "cindy-account-controls"
          },
          {
            "kind": "account_table"
          }
        ],
        "table": {
          "layouts": [
            "table",
            "compact",
            "cards"
          ],
          "column_refs": [
            "cindy-probe-summary"
          ],
          "action_refs": [
            "cindy-balance-recover"
          ]
        },
        "navigation": {
          "section": "admin.extensions",
          "target_view": "cindy-accounts",
          "icon": "accounts"
        },
        "legacy_query_aliases": [
          {
            "match": {
              "cindy_health_status": "banned"
            },
            "preset": "banned",
            "priority": 30
          },
          {
            "match": {
              "cindy_balance_status": "insufficient"
            },
            "preset": "insufficient",
            "priority": 20
          },
          {
            "match": {
              "cindy_only": "true"
            },
            "preset": "cindy",
            "priority": 10
          }
        ]
      }
    },
    {
      "id": "cindy-account-controls",
      "slot": "surface",
      "entrypoint": "ui/compiled/index.html",
      "retained_controls": true,
      "capability": "extensions.provider.v1",
      "permission": "admin",
      "events": [
        "refresh_current_account_view"
      ],
      "label": {
        "zh": "Cindy 账号操作",
        "en": "Cindy account operations"
      }
    },
    {
      "id": "cindy-balance-recover",
      "slot": "account.actions",
      "capability": "extensions.provider.v1",
      "permission": "admin",
      "label": {
        "zh": "恢复 Cindy 余额状态",
        "en": "Recover Cindy balance"
      },
      "account_filter": {
        "platforms": [
          "cindy"
        ],
        "types": [
          "apikey"
        ]
      },
      "resource_action": {
        "version": 1,
        "resource": "cindy.balance.recover",
        "account_parameter": "id",
        "account_source": "row.id",
        "row_predicate": {
          "cindy_only": true,
          "cindy_balance_status": "insufficient"
        },
        "effect": "refresh_current_account_view"
      }
    },
    {
      "id": "cindy-edit",
      "slot": "account.edit.v1",
      "capability": "extensions.provider.v1",
      "permission": "admin",
      "label": { "zh": "Cindy 账号设置", "en": "Cindy account settings" },
      "account_edit": {
        "version": 1,
        "platform": "cindy",
        "account_type": "apikey",
        "credential_profile": "cindy_laxa_v1",
        "credential_ui": {
          "base_url": "https://api.laxarouter.ai",
          "base_url_readonly": true,
          "hint": { "zh": "凭据和设备身份由宿主管理。", "en": "The host manages credentials and device identity." }
        },
        "catalog_source": "provider_catalog_snapshot_v1",
        "mapping_policy": "managed_catalog_v1",
        "compact_mapping_editable": true,
        "wire_controls": [
          { "target": "responses_mode", "values": ["auto", "force_responses", "force_chat_completions"], "allow_clear": true },
          { "target": "compact_mode", "values": ["auto", "force_on", "force_off"], "allow_clear": true },
          { "target": "responses_websocket_mode", "values": ["off", "ctx_pool", "passthrough", "http_bridge"], "allow_clear": true }
        ],
        "unlisted_fields": "preserve",
        "labels": {
          "managed_catalog": { "zh": "托管目录", "en": "Managed catalog" },
          "managed_aliases": { "zh": "托管别名", "en": "Managed aliases" },
          "custom_mappings": { "zh": "自定义映射", "en": "Custom mappings" }
        }
      }
    },
    {
      "id": "cindy-create",
      "slot": "account.create.v1",
      "capability": "extensions.provider.v1",
      "permission": "admin",
      "label": { "zh": "Cindy", "en": "Cindy" },
      "account_create": {
        "version": 1,
        "platform": "cindy",
        "account_type": "apikey",
        "credential_profile": "cindy_laxa_v1",
        "credential_ui": {
          "base_url": "https://api.laxarouter.ai",
          "base_url_readonly": true,
          "api_key_placeholder": "cindy-...",
          "hint": { "zh": "使用 Cindy API Key", "en": "Use a Cindy API key" },
          "base_url_hint": { "zh": "Cindy 使用声明的固定服务地址。", "en": "Cindy uses the fixed endpoint declared by its provider." },
          "account_type_hint": { "zh": "以 Cindy API Key 创建账号。未选择分组时由服务端尝试默认分组，最终必须有有效分组。", "en": "Create a Cindy API-key account. When no group is selected, the server tries its default group; the final account must have an effective group." },
          "catalog_label": { "zh": "供应商管理的模型目录", "en": "Provider-managed model catalog" },
          "catalog_hint": { "zh": "可用模型由供应商目录提供，创建时不编辑映射。", "en": "Model IDs come from the provider catalog; mappings are not edited during creation." }
        },
        "defaults": { "concurrency": 3, "priority": 50, "rate_multiplier": 1, "load_factor": null, "responses_mode": "force_responses" },
        "minimum_effective_groups": 1,
        "upstream_billing_probe": "unsupported",
        "model_editing": "provider_managed",
        "catalog_source": "group_model_candidates",
        "field_bindings": { "device_id": "provider_device_identity_input" }
      },
      "fields": [
        {
          "key": "device_id",
          "kind": "text",
          "label": { "zh": "设备 ID", "en": "Device ID" },
          "max_length": 64,
          "hint": { "zh": "留空由服务端生成；填写的设备身份由服务端验证并保留。", "en": "Leave empty for server generation. The server validates and preserves a supplied device identity." }
        }
      ]
    }
  ],
  "runtimes": {},
  "ui": {
    "entrypoint": "ui/index.html"
  },
  "files": {}
}

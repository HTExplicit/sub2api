{
  "schema_version": 1,
  "id": "codexrip.codex-runtime",
  "name": "Codex 运行扩展",
  "version": "0.2.9",
  "description": "Cookie 路由资格、按需有界续获与出站指纹",
  "author": "HTExplicit",
  "requires": {
    "sub2api": ">=0.2.7-codexrip.2 <0.2.8",
    "tested_sub2api_versions": [],
    "plugin_protocol": 1,
    "transport_api": 1,
    "ui_bridge": 1,
    "extension_api": 1
  },
  "capabilities": [
    { "id": "extensions.recovery.v1", "platform": "openai", "account_type": "*" },
    { "id": "extensions.credentials.v1", "platform": "openai", "account_type": "oauth" },
    { "id": "extensions.credentials.v1", "platform": "openai", "account_type": "setup-token" },
    { "id": "extensions.admin.v1", "platform": "openai", "account_type": "oauth" },
    { "id": "extensions.admin.v1", "platform": "openai", "account_type": "setup-token" },
    { "id": "extensions.scheduling.v1", "platform": "openai", "account_type": "oauth" },
    { "id": "extensions.scheduling.v1", "platform": "openai", "account_type": "setup-token" },
    { "id": "extensions.request.v1", "platform": "openai", "account_type": "oauth" },
    { "id": "extensions.request.v1", "platform": "openai", "account_type": "setup-token" },
    { "id": "extensions.jobs.v1", "platform": "openai", "account_type": "oauth" },
    { "id": "extensions.jobs.v1", "platform": "openai", "account_type": "setup-token" }
  ],
  "operations": {
    "extensions.request.v1": ["inject", "codex.routing.demand", "codex.routing.observe", "codex.identity.available", "codex.identity.plan", "codex.identity.derive", "codex.identity.validate", "codex.identity.agent", "codex.identity.sandbox", "codex.transport.plan"],
    "extensions.recovery.v1": ["codex.recovery.available", "codex.recovery.enabled", "codex.recovery.rejection", "codex.recovery.select", "codex.replay.rules"]
  },
  "contributions": [
    { "id": "ops-error-diagnostics", "slot": "surface", "entrypoint": "ui/diagnostics.html", "capability": "extensions.recovery.v1", "permission": "admin", "label": { "zh": "Codex 续接诊断", "en": "Codex continuation diagnostics" } },
    { "id": "codex-recovery-settings", "slot": "surface", "capability": "extensions.recovery.v1", "permission": "admin", "label": { "zh": "推理状态与恢复策略", "en": "Reasoning state and recovery" } },
    {
      "id": "proxy-settings", "slot": "admin.settings", "capability": "extensions.admin.v1", "action": "proxy.test", "entrypoint": "ui/index.html", "permission": "admin",
      "label": { "zh": "Codex 路由采集与验证", "en": "Codex route acquisition and verification" }
    },
    {
      "id": "ticket-harvest", "slot": "account.actions", "capability": "extensions.credentials.v1", "action": "harvest", "entrypoint": "ui/index.html", "permission": "admin",
      "label": { "zh": "采集并验证 Codex 路由", "en": "Acquire and verify Codex route" },
      "account_filter": { "platforms": ["openai"], "types": ["oauth", "setup-token"], "exclude_shadows": true }
    },
    {
      "id": "ticket-stop", "slot": "account.actions", "capability": "extensions.admin.v1", "action": "stop", "entrypoint": "ui/index.html", "permission": "admin",
      "label": { "zh": "停止路由续期", "en": "Stop route renewal" },
      "account_filter": { "platforms": ["openai"], "types": ["oauth", "setup-token"], "exclude_shadows": true }
    }
  ],
  "resources": [{ "name": "ops.error.diagnostics", "capability": "extensions.recovery.v1", "permission": "admin" }, { "name": "codex.fingerprint", "capability": "extensions.request.v1", "permission": "admin" }, { "name": "codex.fingerprint.profile", "capability": "extensions.request.v1", "permission": "admin" }, { "name": "codex.routing.validate", "capability": "extensions.credentials.v1", "permission": "admin" }],
  "runtimes": {},
  "ui": { "entrypoint": "ui/index.html" },
  "files": {}
}

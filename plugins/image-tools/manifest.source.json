    { "id": "image-studio", "slot": "surface", "config_flag": "studio_enabled", "permission": "user", "label": { "zh": "Image Studio", "en": "Image Studio" } },
    { "id": "image-tools-settings", "slot": "admin.settings", "action": "image.describe", "entrypoint": "ui/index.html", "permission": "admin", "label": { "zh": "图像工具", "en": "Image tools" } }
  ],
  "runtimes": {},
  "ui": { "entrypoint": "ui/index.html" },
  "files": {}
}

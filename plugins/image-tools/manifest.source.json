{
  "schema_version": 1,
  "id": "codexrip.image-tools",
  "name": "图像工具",
  "version": "0.2.7",
  "description": "Image Studio 请求计划、模型能力和 Responses 图像桥接策略",
  "author": "HTExplicit",
  "requires": { "sub2api": ">=0.2.7-0 <0.2.8", "tested_sub2api_versions": [], "plugin_protocol": 1, "transport_api": 1, "ui_bridge": 1, "extension_api": 1 },
  "capabilities": [
    { "id": "extensions.request.v1", "platform": "*", "account_type": "*" },
    { "id": "extensions.admin.v1", "platform": "*", "account_type": "*" }
  ],
  "dependencies": [{ "capability": "extensions.provider.v1", "platform": "cindy", "account_type": "apikey" }],
  "operations": { "extensions.request.v1": ["image.features", "image.studio.plan", "image.studio.validate", "image.studio.models"] },

{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["./src/*"],
      "@sub2api/plugin-ui": ["../backend/pkg/extensionapi/ui/index.ts"],
      "@sub2api/plugin-ui/*": ["../backend/pkg/extensionapi/ui/*"],
      "vue-draggable-plus": ["./node_modules/vue-draggable-plus"],
      "vue": ["./node_modules/vue"],
      "vue-i18n": ["./node_modules/vue-i18n"]
    },
    "types": ["vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue"],
  "exclude": ["src/**/__tests__/**", "src/**/*.spec.ts", "src/**/*.test.ts"],
  "references": [{ "path": "./tsconfig.node.json" }]
}

# 确保所有 SQL 迁移文件使用 LF 换行符
backend/migrations/*.sql text eol=lf

# Go 源代码文件
*.go text eol=lf

# Embedded system prompt seed must retain the exact LF byte sequence used for
# its published SHA-256 and UTF-8 byte-length invariants.
backend/internal/service/prompts/*.txt text eol=lf
backend/internal/service/prompts/*.md text eol=lf

# The approved ModelGang seed is embedded in the application. Keep its textual
# bytes stable so the raw/effective tree hashes are cross-platform.
backend/internal/service/remote_skill_seed/tree/**/*.md text eol=lf -whitespace
backend/internal/service/remote_skill_seed/tree/**/*.json text eol=lf -whitespace
backend/internal/service/remote_skill_seed/tree/**/*.py text eol=lf -whitespace
backend/internal/service/remote_skill_seed/tree/**/*.ps1 text eol=lf -whitespace

# 前端 源代码文件
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.vue text eol=lf

# Shell 脚本
*.sh text eol=lf

# YAML/YML 配置文件
*.yaml text eol=lf
*.yml text eol=lf

# Dockerfile
Dockerfile text eol=lf

# 确保所有 SQL 迁移文件使用 LF 换行符
backend/migrations/*.sql text eol=lf

# Go 源代码文件
*.go text eol=lf

# Embedded system prompt seed must retain the exact LF byte sequence used for
# its published SHA-256 and UTF-8 byte-length invariants.
backend/internal/promptskills/registry/prompts/*.txt text eol=lf
backend/internal/promptskills/source/prompts/*.md text eol=lf
backend/internal/service/testdata/codexrip_reverse_skill_system_prompt_legacy_dual_marker.txt text eol=lf

# The approved ModelGang seed is UTF-8 text, including extensionless and
# Unicode-named files. Keep every embedded byte sequence stable cross-platform.
backend/internal/promptskills/registry/seed/manifest.json text eol=lf -whitespace
backend/internal/promptskills/registry/seed/tree/** text eol=lf -whitespace
backend/internal/promptskills/registry/seed/pinned/** text eol=lf -whitespace

# 前端 源代码文件
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.vue text eol=lf

# Shell 脚本
*.sh text eol=lf
tools/sync_modelgang_remote_skill_seed.ps1 text eol=lf

# YAML/YML 配置文件
*.yaml text eol=lf
*.yml text eol=lf

# Dockerfile
Dockerfile text eol=lf

# Signed resources and review fingerprints must identify the same source bytes
# on developer Windows checkouts and Linux release builders.
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.svg text eol=lf
*.md text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.py text eol=lf
*.ps1 text eol=lf
go.mod text eol=lf
go.sum text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
.dockerignore text eol=lf
.env.example text eol=lf
Dockerfile* text eol=lf
Makefile text eol=lf

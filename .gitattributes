# 确保所有 SQL 迁移文件使用 LF 换行符
backend/migrations/*.sql text eol=lf

# Go 源代码文件
*.go text eol=lf

# Embedded system prompt seed must retain the exact LF byte sequence used for
# its published SHA-256 and UTF-8 byte-length invariants.
backend/internal/service/prompts/moxinggang_reverse_skill_system_prompt.txt text eol=lf

# Integrity manifests are byte-for-byte release artifacts. Git must not rewrite
# or text-diff them because the pinned digest also covers the embedded copy.
deploy/skill-bundles/**/bundle-manifest.json -text -diff

# 前端 源代码文件
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.vue text eol=lf

# Shell 脚本
*.sh text eol=lf

# YAML/YML 配置文件
*.yaml text eol=lf
*.yml text eol=lf

# Dockerfile
Dockerfile text eol=lf

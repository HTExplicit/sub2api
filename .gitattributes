# 确保所有 SQL 迁移文件使用 LF 换行符
backend/migrations/*.sql text eol=lf

# Go 源代码文件
*.go text eol=lf

# 前端 源代码文件
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.vue text eol=lf

# Shell 脚本
*.sh text eol=lf

# YAML/YML 配置文件
*.yaml text eol=lf
*.yml text eol=lf

# Dockerfile
Dockerfile text eol=lf

# Keep these text files LF in every checkout, so a Windows working tree
# (core.autocrlf) holds the same bytes as the Linux CI and release builders.
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.svg text eol=lf
*.md text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.py text eol=lf
# Upstream stores this one script with CRLF; keep its bytes as they are.
tools/check_pnpm_audit_exceptions.py -text
go.mod text eol=lf
go.sum text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
.dockerignore text eol=lf
.env.example text eol=lf
Dockerfile* text eol=lf
Makefile text eol=lf
